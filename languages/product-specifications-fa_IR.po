msgid "Clear search"
msgstr "پاک کردن جستجو"

#: assets/chunks/specifications.js:23
msgid "No specifications yet"
msgstr "هنوز مشخصه‌ای وجود ندارد"

#: assets/chunks/specifications.js:23
msgid "A specification is one row of a product table — a screen size, a weight, a material. Define it once and use it in any set."
msgstr "مشخصه یک ردیف از جدول محصول است — اندازه صفحه‌نمایش، وزن، جنس. یک بار تعریفش کنید و در هر مجموعه‌ای از آن استفاده کنید."

#: assets/chunks/specifications.js:23
msgid "Specifications could not be loaded"
msgstr "مشخصات بارگذاری نشدند"

#: assets/chunks/specifications.js:23
msgid "Your specifications are still intact. Check the connection and try again."
msgstr "مشخصات شما همچنان سالم هستند. اتصال را بررسی کنید و دوباره تلاش کنید."

#: assets/chunks/specifications.js:23
msgid "Define each specification once, then use it in any set."
msgstr "هر مشخصه را یک بار تعریف کنید، سپس در هر مجموعه‌ای از آن استفاده کنید."

#: assets/product-values.js:9
msgid "The request failed. Please try again."
msgstr "درخواست ناموفق بود. لطفاً دوباره تلاش کنید."

#: assets/product-values.js:9
msgid "Suggested"
msgstr "پیشنهادشده"

#. translators: %s: unavailable specification type id.
#: assets/product-values.js:10
#, js-format
msgid "The “%s” value type is unavailable. Its raw stored value is preserved until you replace it."
msgstr "نوع مقدار «%s» در دسترس نیست. مقدار خام ذخیره‌شده آن تا زمانی که جایگزینش کنید حفظ می‌شود."

#: assets/product-values.js:10
msgid "Raw stored value"
msgstr "مقدار خام ذخیره‌شده"

#: assets/product-values.js:10
msgid "This product’s specifications appear here once the Product Specifications migration has run. If you save specifications for it before then, the migration skips this product and keeps what you saved."
msgstr "مشخصات این محصول پس از اجرای مهاجرت مشخصات محصول این‌جا نمایش داده می‌شوند. اگر پیش از آن مشخصاتی برای آن ذخیره کنید، مهاجرت این محصول را نادیده می‌گیرد و آنچه ذخیره کرده‌اید را نگه می‌دارد."

#: assets/product-values.js:10
msgid "Your entered values are still here."
msgstr "مقادیری که وارد کرده‌اید همچنان این‌جا هستند."

#: assets/product-values.js:10
msgid "Saving product specifications…"
msgstr "در حال ذخیره مشخصات محصول…"

#: assets/product-values.js:10
msgid "Change"
msgstr "تغییر"

#. translators: 1: number of specifications, 2: number of groups.
#: assets/product-values.js:11
#, js-format
msgid "%1$d specifications in %2$d groups"
msgstr "%1$d مشخصه در %2$d گروه"

#: assets/product-values.js:11
msgid "No specifications apply until a specification set is chosen."
msgstr "تا زمانی که مجموعه مشخصاتی انتخاب نشود، هیچ مشخصه‌ای اعمال نمی‌شود."

#: assets/product-values.js:11
msgid "No specification set"
msgstr "بدون مجموعه مشخصات"

#: assets/product-values.js:11
msgid "Choose a set"
msgstr "انتخاب مجموعه"

#: assets/product-values.js:11
msgid "Continue"
msgstr "ادامه"

#: assets/product-values.js:11
msgid "Assign a specification set"
msgstr "اختصاص مجموعه مشخصات"

#: assets/product-values.js:11
msgid "The assigned specification set is missing. Choose another set before saving."
msgstr "مجموعه مشخصات اختصاص‌داده‌شده وجود ندارد. پیش از ذخیره، مجموعه دیگری انتخاب کنید."

#: assets/product-values.js:11
msgid "This set has no specification groups yet."
msgstr "این مجموعه هنوز هیچ گروه مشخصاتی ندارد."

#. translators: %s: slug of a missing specification.
#: assets/product-values.js:12
#, js-format
msgid "Missing specification: %s"
msgstr "مشخصه موجود نیست: %s"

#: assets/product-values.js:12
msgid "Specification values are saved with the product’s Update button."
msgstr "مقادیر مشخصات با دکمه «به‌روزرسانی» محصول ذخیره می‌شوند."

#: assets/product-values.js:12
msgid "Remove specification set?"
msgstr "مجموعه مشخصات حذف شود؟"

#: assets/product-values.js:12
msgid "Change specification set?"
msgstr "مجموعه مشخصات تغییر کند؟"

#. translators: %d: number of stored values to delete.
#: assets/product-values.js:13
#, js-format
msgid "%d stored value will be deleted when the product is saved."
msgid_plural "%d stored values will be deleted when the product is saved."
msgstr[0] "%d مقدار ذخیره‌شده هنگام ذخیره محصول حذف خواهد شد."

#: assets/product-values.js:13
msgid "Values shared by both sets stay in place. Values used only by the old set are kept and return if you switch back."
msgstr "مقادیر مشترک بین دو مجموعه سر جای خود می‌مانند. مقادیری که فقط در مجموعه قبلی استفاده می‌شوند نگه داشته می‌شوند و اگر برگردید، بازمی‌گردند."

#: assets/product-values.js:13
msgid "Remove on save"
msgstr "حذف هنگام ذخیره"

#: assets/product-values.js:13
msgid "Change set"
msgstr "تغییر مجموعه"

