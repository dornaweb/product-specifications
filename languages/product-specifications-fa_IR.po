#. translators: 1: a migration step, 2: an item id.
#: src/Migration/MigrationCommand.php:99
#, php-format
msgid "Skipped %1$s %2$d: it already holds data in the current format."
msgstr "%1$s %2$d نادیده گرفته شد: از قبل داده‌ای با قالب فعلی دارد."

#: src/Migration/MigrationNotice.php:59
msgid "Product Specifications is migrating your data. Specification tables return to your store when it finishes."
msgstr "مشخصات محصول در حال مهاجرت داده‌های شماست. پس از پایان آن، جدول‌های مشخصات به فروشگاه شما بازمی‌گردند."

#: src/Migration/MigrationNotice.php:63
msgid "View progress"
msgstr "مشاهده پیشرفت"

#: src/Migration/MigrationNotice.php:70
msgid "The Product Specifications migration stopped before it finished. Your store shows no specification tables until it completes."
msgstr "مهاجرت مشخصات محصول پیش از پایان متوقف شد. تا زمان تکمیل آن، فروشگاه شما هیچ جدول مشخصاتی نمایش نمی‌دهد."

#: src/Migration/MigrationNotice.php:74
msgid "Review and resume"
msgstr "بررسی و ادامه"

#: src/Migration/MigrationNotice.php:80
msgid "Product Specifications needs to migrate your data. Until it does, your store shows no specification tables, the product editor shows them empty, and any product you edit is skipped by the migration."
msgstr "مشخصات محصول باید داده‌های شما را مهاجرت دهد. تا آن زمان، فروشگاه شما هیچ جدول مشخصاتی نمایش نمی‌دهد، ویرایشگر محصول آن‌ها را خالی نشان می‌دهد و هر محصولی که ویرایش کنید در مهاجرت نادیده گرفته می‌شود."

#: src/Migration/MigrationNotice.php:84
msgid "Start the migration"
msgstr "شروع مهاجرت"

