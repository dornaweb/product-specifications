#. translators: %s: a specification slug.
#: src/ImportExport/Section/ValuesSection.php:250
#, php-format
msgid "Skips the value for \"%s\": no specification has that slug."
msgstr "مقدار «%s» نادیده گرفته می‌شود: هیچ مشخصه‌ای این نامک را ندارد."

#. translators: %s: a specification slug.
#: src/ImportExport/Section/ValuesSection.php:270
#, php-format
msgid "Skips the value for \"%s\": the specification's type does not accept it."
msgstr "مقدار «%s» نادیده گرفته می‌شود: نوع مشخصه آن را نمی‌پذیرد."

#: src/ImportExport/Section/ValuesSection.php:400
msgid "needs a sku or a slug"
msgstr "به شناسه محصول (SKU) یا نامک نیاز دارد"

#: src/ImportExport/Section/ValuesSection.php:424
msgid "is not a specification slug"
msgstr "نامک مشخصه نیست"

#: src/ImportExport/Shape.php:21
#: src/ImportExport/Shape.php:103
msgid "is required"
msgstr "الزامی است"

#: src/ImportExport/Shape.php:25
msgid "must be text"
msgstr "باید متن باشد"

#: src/ImportExport/Shape.php:29
msgid "must not be empty"
msgstr "نباید خالی باشد"

#: src/ImportExport/Shape.php:46
msgid "may contain only lowercase letters, digits, dashes and underscores"
msgstr "فقط می‌تواند شامل حروف کوچک، رقم، خط تیره و زیرخط باشد"

#: src/ImportExport/Shape.php:71
msgid "must not be a whole number"
msgstr "نباید یک عدد صحیح باشد"

#: src/ImportExport/Shape.php:76
msgid "is not a key as the plugin stores it"
msgstr "کلیدی به شکلی که افزونه ذخیره می‌کند نیست"

#: src/ImportExport/Shape.php:93
msgid "must be true or false"
msgstr "باید درست یا نادرست باشد"

#: src/ImportExport/Shape.php:128
msgid "is a duplicate"
msgstr "تکراری است"

#: src/Integration/WooCommerce/ProductTabSettings.php:22
msgid "Specifications tab title"
msgstr "عنوان زبانه مشخصات"

#: src/Integration/WooCommerce/ProductTabSettings.php:23
msgid "The heading of the specifications tab on a product page. Leave it empty to use “Specifications”."
msgstr "عنوان زبانه مشخصات در صفحه محصول. برای استفاده از «مشخصات» خالی بگذارید."

#: src/Integration/WooCommerce/ProductTabSettings.php:33
msgid "WooCommerce’s own “Additional information” tab"
msgstr "زبانه «اطلاعات بیشتر» خود ووکامرس"

#: src/Integration/WooCommerce/ProductTabSettings.php:34
msgid "WooCommerce shows weight, dimensions and attributes in its own tab. Choose whether it stays alongside yours."
msgstr "ووکامرس وزن، ابعاد و ویژگی‌ها را در زبانه خودش نمایش می‌دهد. انتخاب کنید که در کنار زبانه شما باقی بماند یا نه."

#: src/Integration/WooCommerce/ProductTabSettings.php:40
msgid "Remove it when this product has specifications"
msgstr "وقتی این محصول مشخصات دارد، حذف شود"

#: src/Integration/WooCommerce/ProductTabSettings.php:44
msgid "Always remove it"
msgstr "همیشه حذف شود"

#: src/Integration/WooCommerce/ProductTabSettings.php:45
msgid "Always keep it"
msgstr "همیشه باقی بماند"

#: src/Integration/WooCommerce/WooCommerceNotInstalledNoticeHandler.php:31
msgid "This plugin needs \"WooCommerce\" to run, please install \"WooCommerce\" first."
msgstr "این افزونه برای اجرا به «ووکامرس» نیاز دارد، لطفاً ابتدا «ووکامرس» را نصب کنید."

