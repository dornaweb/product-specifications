#. translators: 1: the file's schema version, 2: the newest schema version this site reads.
#: src/ImportExport/PackageReader.php:125
#, php-format
msgid "The file uses package schema %1$d, made by a newer version of Product Specifications. This site reads up to schema %2$d. Update the plugin and try again."
msgstr "این فایل از نسخه طرح‌واره بسته %1$d استفاده می‌کند که با نسخه جدیدتری از مشخصات محصول ساخته شده است. این سایت تا نسخه طرح‌واره %2$d را می‌خواند. افزونه را به‌روزرسانی کنید و دوباره تلاش کنید."

#. translators: %s: comma-separated list of allowed statuses.
#: src/ImportExport/Section/SetsSection.php:66
#, php-format
msgid "must be one of: %s"
msgstr "باید یکی از این‌ها باشد: %s"

