parameters:
	ignoreErrors:
		-
			message: '#^Binary operation "\." between mixed and ''assets'' results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: src/Assets/Module.php

		-
			message: '#^Cannot call method basePath\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: src/Assets/Module.php

		-
			message: '#^Cannot call method baseUrl\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: src/Assets/Module.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 1
			path: src/Assets/Module.php

		-
			message: '#^Parameter \#1 \$pluginProperties of class Amiut\\ProductSpecs\\Integration\\WooCommerce\\FeaturesCompatibilityDeclarations constructor expects Inpsyde\\Modularity\\Properties\\PluginProperties, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Integration/Module.php

		-
			message: '#^Method Amiut\\ProductSpecs\\Integration\\WooCommerce\\FeaturesCompatibilityDeclarations\:\:__invoke\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/Integration/WooCommerce/FeaturesCompatibilityDeclarations.php

